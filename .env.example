# =============================================================================
# PRZYSTANECZKI - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your configuration values.
# =============================================================================

# MSSQL Database Configuration (Azure SQL or local MSSQL instance)
MSSQL_SERVER=your-mssql-server.database.windows.net
MSSQL_DATABASE=komunikacjamiejska
MSSQL_USER=your_db_user
MSSQL_PASSWORD=your_db_password
MSSQL_PORT=1433
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true

# Telegram Bot Configuration (obtained via @BotFather)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
BOT_USERNAME=your_bot_username
BOT_ID=123456789
PUBLIC_BOT_NAME=your_bot_username
PUBLIC_BOT_ID=123456789

# System Administrators (comma-separated list of Telegram numeric user IDs)
ADMIN_TELEGRAM_IDS=123456789,987654321

# Development & Testing (set to 'false' in production!)
ENABLE_DEV_LOGIN=false

# External APIs Configuration (defaults for Gdynia / ZDiZ / ZKM)
TRISTAR_API_BASE_URL=http://api.zdiz.gdynia.pl/pt
GTFS_ZIP_URL=http://api.zdiz.gdynia.pl/pt/gtfs.zip
ZKM_BASE_URL=https://zkmgdynia.pl
